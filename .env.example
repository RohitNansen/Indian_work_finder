# Keep this file as an example. Put real values only in a private .env on the VM.
APP_PASSWORD=replace-with-a-long-unique-password
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=https://hithanis.com/job-finder
DATA_DIR=./data
JSEARCH_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
RESEND_API_KEY=
# Free alternative: a Google app password for EMAIL_FROM (requires 2-Step Verification).
GMAIL_APP_PASSWORD=
EMAIL_FROM=Job Finder <alerts@example.com>
QUOTA_ALERT_EMAIL=
# Free Resend plan defaults. Change these if you choose another plan.
RESEND_DAILY_QUOTA=100
RESEND_MONTHLY_QUOTA=3000
JSEARCH_MAX_REQUESTS_PER_RUN=20
OPENROUTER_MAX_JOBS_PER_RUN=40
MONTHLY_SPEND_LIMIT_USD=8
# Public employer web lookups through OpenRouter after JSearch cannot find the company link.
# Up to three per search; bounded separately from JSearch. Each uses a $0.005 search plus model tokens.
EMPLOYER_WEB_LOOKUPS_PER_RUN=3
