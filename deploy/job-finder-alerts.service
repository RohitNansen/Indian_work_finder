[Unit]
Description=Check Indian Work Engine email alerts
After=network-online.target

[Service]
Type=oneshot
User=jobfinder
Group=jobfinder
WorkingDirectory=/opt/indian-work-engine
ExecStart=/usr/bin/flock -n /tmp/indian-work-engine-alerts.lock /opt/indian-work-engine/.venv/bin/python -m app.alerts
NoNewPrivileges=true
PrivateTmp=false
