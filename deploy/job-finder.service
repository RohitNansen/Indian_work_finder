[Unit]
Description=Indian Work Engine web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jobfinder
Group=jobfinder
WorkingDirectory=/opt/indian-work-engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/indian-work-engine/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
