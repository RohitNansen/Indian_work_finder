[Unit]
Description=Indian Work Engine web app
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=rsa-key-20240330
Group=rsa-key-20240330
WorkingDirectory=/home/rsa-key-20240330/indian-work-engine
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rsa-key-20240330/indian-work-engine/.venv/bin/uvicorn app.main:app --host 172.20.0.1 --port 8765 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
