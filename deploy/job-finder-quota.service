[Unit]
Description=Check Job Finder provider quotas
After=network-online.target

[Service]
Type=oneshot
User=rsa-key-20240330
Group=rsa-key-20240330
WorkingDirectory=/home/rsa-key-20240330/indian-work-engine
ExecStart=/usr/bin/flock -n /tmp/indian-work-engine-quota.lock /home/rsa-key-20240330/indian-work-engine/.venv/bin/python -m app.quota
NoNewPrivileges=true
PrivateTmp=false
